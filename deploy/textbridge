#!/usr/bin/env bash
# textbridge helper. Usage: sudo textbridge <command>
set -euo pipefail

BIN=/opt/textbridge/bin
DATA=/var/lib/textbridge
REPO="${TB_REPO:-kaibrownco/textbridge}"

need_root() { [ "$(id -u)" -eq 0 ] || { echo "Run with sudo: sudo textbridge $*"; exit 1; }; }
as_tb() { sudo -u textbridge env HOME="$DATA/openmessage" OPENMESSAGES_DATA_DIR="$DATA/openmessage" TB_STATE_DIR="$DATA/gateway" "$@"; }

cmd="${1:-help}"
case "$cmd" in
  status)
    for s in textbridge-openmessage textbridge-gateway caddy; do
      printf '%-26s %s\n' "$s" "$(systemctl is-active "$s" || true)"
    done
    echo
    echo "Phone link (latest events):"
    journalctl -u textbridge-openmessage --no-pager -n 3000 -o cat 2>/dev/null \
      | grep -E "Connected to Google Messages|auth expired|supervisor parked|connection lost|Phone not responding|Phone responding again|Deep backfill complete" \
      | tail -5 | sed 's/^/  /'
    echo
    echo "Connector URL: https://$(cat /etc/textbridge/domain)/mcp"
    ;;
  pair)
    need_root pair
    cat <<'EOF'

Link your phone (one time; repeat only if texts stop coming through)
--------------------------------------------------------------------
1. On your phone: Google Messages > profile picture > Device pairing.
   Make sure you're signed in to your Google account there.
2. On your computer, open a PRIVATE window in Firefox or Safari (NOT Chrome:
   Chrome locks the sign-in to itself and the link dies within hours) and go
   to messages.google.com/web. Sign in with the same Google account.
   Safari: first turn on Settings > Advanced > "Show features for web developers".
3. Open the developer tools (Firefox: F12, Safari: Option+Cmd+I), Network
   tab, reload, click the first request to messages.google.com, and under
   Request Headers copy the whole value of "Cookie" (name=value; name=value...).
4. Paste it below, press Enter, then press Ctrl+D.
5. Tap the matching emoji on your phone when asked.
6. Close the private window (don't sign out of it).

EOF
    systemctl stop textbridge-openmessage
    trap 'systemctl start textbridge-openmessage' EXIT
    as_tb "$BIN/openmessage" pair --google
    echo
    echo "Paired. Starting the service; your history will sync in the background."
    ;;
  backfill)
    need_root backfill
    env=/etc/textbridge/openmessage.env
    sed -i '/^OPENMESSAGES_STARTUP_BACKFILL=/d' "$env"
    echo "OPENMESSAGES_STARTUP_BACKFILL=deep" >> "$env"
    trap 'sed -i "/^OPENMESSAGES_STARTUP_BACKFILL=/d" "$env"; systemctl restart textbridge-openmessage' EXIT
    since="$(date '+%Y-%m-%d %H:%M:%S')"
    systemctl restart textbridge-openmessage
    echo "Downloading your full text history. Keep your phone unlocked and on Wi-Fi."
    echo "This can take 20-60 minutes. Leave this window open."
    journalctl -u textbridge-openmessage -f --since "$since" -o cat \
      | grep -m1 "Deep backfill complete" | sed 's/^/Done: /'
    ;;
  pair-from-file)
    # Run by textbridge-pair.service when the web page drops a request.
    need_root pair-from-file
    pdir="$DATA/gateway/pair"
    req="$pdir/request.cookie"
    status="$pdir/status"
    [ -s "$req" ] || exit 0
    setst() { printf '%s\n' "$@" > "$status.tmp"; chown textbridge:textbridge "$status.tmp"; chmod 600 "$status.tmp"; mv -f "$status.tmp" "$status"; }
    work="$DATA/openmessage/.pair-cookie"
    mv -f "$req" "$work"; chown textbridge:textbridge "$work"; chmod 600 "$work"
    setst "state=running"
    systemctl stop textbridge-openmessage
    log="$(mktemp)"
    set +e
    sudo -u textbridge env HOME="$DATA/openmessage" OPENMESSAGES_DATA_DIR="$DATA/openmessage" \
      timeout 180 "$BIN/openmessage" pair --google-file "$work" 2>&1 | while IFS= read -r line; do
        printf '%s\n' "$line" >> "$log"
        case "$line" in
          EMOJI:*) setst "state=emoji" "emoji=$(printf '%s' "${line#EMOJI:}" | tr -d ' ')" ;;
        esac
      done
    rc=${PIPESTATUS[0]}
    set -e
    rm -f "$work"
    if [ "$rc" -eq 0 ] && grep -q "Pairing successful" "$log"; then
      setst "state=success"
    else
      msg="$(grep -E 'FTL|Fatal|error=' "$log" | tail -1 | sed 's/.*error="\{0,1\}//; s/"$//' | tr -d '\n' | cut -c1-200)"
      [ "$rc" -eq 124 ] && msg="Timed out waiting for your phone. Keep Google Messages open and try again."
      setst "state=error" "message=${msg:-Pairing failed.}"
    fi
    rm -f "$log"
    systemctl start textbridge-openmessage
    ;;
  restart)
    need_root restart
    systemctl restart textbridge-openmessage textbridge-gateway caddy
    echo "Restarted."
    ;;
  update)
    need_root update
    curl -fsSL "https://raw.githubusercontent.com/${REPO}/main/deploy/setup.sh" | bash
    ;;
  new-password)
    need_root new-password
    pw="$(as_tb "$BIN/textbridge-gateway" new-password)"
    as_tb "$BIN/textbridge-gateway" sign-out-all >/dev/null
    systemctl restart textbridge-gateway
    echo "New passphrase (save it now):"
    echo
    echo "    $pw"
    echo
    echo "Every Claude session was signed out. Reconnect in Claude's connector settings."
    ;;
  sign-out-all)
    need_root sign-out-all
    as_tb "$BIN/textbridge-gateway" sign-out-all
    systemctl restart textbridge-gateway
    ;;
  logs)
    journalctl -u textbridge-openmessage -u textbridge-gateway -n "${2:-80}" --no-pager
    ;;
  *)
    cat <<'EOF'
textbridge commands (run with sudo):
  status         is everything running, and is the phone linked
  pair           link (or re-link) your phone
  backfill       re-download your full text history (keep phone awake)
  restart        restart all services
  update         install the latest version (keeps your data)
  new-password   make a new passphrase and sign Claude out everywhere
  sign-out-all   sign Claude out everywhere (keeps the passphrase)
  logs [N]       show recent log lines
EOF
    ;;
esac
